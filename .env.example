# Copie este arquivo para .env e edite os dados abaixo.
# O banco PostgreSQL deve estar na sua maquina e ter pgvector instalado.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_petmatch
DB_USER=postgres
DB_PASSWORD=troque_pela_sua_senha

# Servidor Ollama LOCAL (na mesma maquina do PHP)
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
CHAT_MODEL=gemma3:1b
